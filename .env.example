# Last.fm Configuration (Music page)
# Get an API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_USERNAME=your_lastfm_username_here

# Goodreads Configuration (Books page)
# Get your user ID from your profile URL: goodreads.com/user/show/<ID>
GOODREADS_USER_ID=your_goodreads_user_id_here

# Letterboxd Configuration (Movies page)
# Username from your profile URL: letterboxd.com/<username>/
LETTERBOXD_USERNAME=your_letterboxd_username_here

# TMDB Configuration (TV page)
# 1. Create an API key at: https://www.themoviedb.org/settings/api (take the v4 API Read Access Token)
# 2. Get account object id: call https://api.themoviedb.org/4/account with "Authorization: Bearer <token>"
# 3. Create your watchlist at: https://www.themoviedb.org/list/create and copy its numeric ID from the URL
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here
TMDB_ACCOUNT_OBJECT_ID=your_tmdb_account_object_id_here
TMDB_TV_LIST_ID=your_tmdb_tv_list_id_here

# MyAnimeList Configuration (Anime page)
# Create an app at: https://myanimelist.net/apiconfig
MAL_CLIENT_ID=your_mal_client_id_here
MAL_ACCESS_TOKEN=your_mal_access_token_here

# Steam API Configuration (Games page)
# Get your API key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here
STEAM_ID=your_steam_id_here
