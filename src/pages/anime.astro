---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimeTabs from '../components/AnimeTabs';
import StatGrid from '../components/StatGrid.astro';
import { getAnimeData } from '../utils/anilist';

// Fetch AniList data at build time
const animeData = await getAnimeData();

// Use AniList data if available
let anime = [];
let favourites = [];
if (animeData && animeData.anime.length > 0) {
  // Map AniList entries to the format expected by the UI
  anime = animeData.anime
    .map(a => ({
      data: {
        title: a.title,
        englishTitle: a.englishTitle,
        imageUrl: a.imageUrl,
        score: a.score,
        status: a.status,
        episodes: a.episodes,
        episodesWatched: a.episodesWatched,
        type: a.type,
        year: a.year,
        startDate: a.startDate,
        endDate: a.endDate,
        entryUrl: a.entryUrl,
      }
    }));
}
if (animeData && animeData.favourites.length > 0) {
  // Map AniList favourites to the same format
  favourites = animeData.favourites
    .map(a => ({
      data: {
        title: a.title,
        englishTitle: a.englishTitle,
        imageUrl: a.imageUrl,
        score: a.score,
        status: a.status,
        episodes: a.episodes,
        episodesWatched: a.episodesWatched,
        type: a.type,
        year: a.year,
        startDate: a.startDate,
        endDate: a.endDate,
        entryUrl: a.entryUrl,
      }
    }));
}

// Calculate stats
const watchingCount = anime.filter(a => a.data.status === 'watching').length;
const completedCount = anime.filter(a => a.data.status === 'completed').length;
const scoredCount = anime.filter(a => a.data.score && a.data.score > 0).length;
const top10Count = anime.filter(a => a.data.score === 10).length;
const watchlist = anime.filter(a => a.data.status === 'plan_to_watch');
const hasAny = anime.length > 0 || favourites.length > 0 || watchlist.length > 0;
---

<BaseLayout
  title="Anime - Hayden"
  description="Anime I've watched"
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4" style="color: var(--text-primary);">
        Anime
      </h1>
    </div>

    {hasAny && (
      <section class="mb-20">
        <AnimeTabs client:load overview={anime} favourites={favourites} watchlist={watchlist} />

        <StatGrid title="Viewing Stats" stats={[
          { value: completedCount, label: 'Completed' },
          { value: watchingCount, label: 'Watching' },
          { value: scoredCount, label: 'Scored' },
          { value: top10Count, label: 'Perfect 10s' },
        ]} />
      </section>
    )}

    {!hasAny && (
      <div class="text-center py-12">
        <p class="text-lg" style="color: var(--text-secondary);">
          {animeData
            ? '你的 AniList 还没有动画记录，去 anilist.co 添加或导入吧～'
            : "Couldn't load anime data right now — check back soon."}
        </p>
      </div>
    )}
  </div>
</BaseLayout>
