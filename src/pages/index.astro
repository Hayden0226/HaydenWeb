---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedCard from '../components/AnimatedCard';
---

<BaseLayout
  title="Hayden - Full-Stack Developer"
  description="Full-stack developer building web apps with Spring Boot, Vue, and TypeScript, with a passion for photography."
  structuredDataType="person"
>
  <!-- About Me -->
  <section class="mb-20 max-w-6xl mx-auto">
    <h2 class="text-4xl font-bold mb-12 text-center" style="color: var(--text-primary);">About Me</h2>

    <!-- Profile Section -->
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <AnimatedCard client:load delay={0} className="md:col-span-1">
        <div class="flex flex-col items-center text-center">
          <img
            src="/images/avatar.png"
            alt="Hayden"
            width="192"
            height="192"
            class="w-48 h-48 rounded-full mb-4 object-cover border-4"
            style="border-color: var(--accent);"
            loading="eager"
            decoding="async"
          />
          <h3 class="text-2xl font-bold mb-2" style="color: var(--text-primary);">Hayden</h3>
          <p class="font-medium mb-4" style="color: var(--accent);">Full-Stack Developer</p>
          <p class="text-sm leading-relaxed mb-6" style="color: var(--text-secondary);">
            Building web applications with Spring Boot, Vue, and TypeScript &mdash; and a photography enthusiast on the side.
          </p>

          <!-- Quick Stats -->
          <div class="w-full mb-6 p-4 rounded-lg" style="background-color: var(--bg-secondary);">
            <div class="flex items-center justify-center gap-2 text-sm mb-2" style="color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>
              </svg>
              <span>Spring Boot &middot; Vue &middot; TypeScript</span>
            </div>
            <div class="flex items-center justify-center gap-2 text-sm" style="color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 12h-4l-3 9L9 3l-3 9H2"/>
              </svg>
              <span>129 Contributions Last Year</span>
            </div>
          </div>

          <!-- Social Links -->
          <div class="w-full mb-6">
            <h4 class="text-xs font-bold uppercase tracking-wider mb-3" style="color: var(--text-secondary);">Connect</h4>
            <div class="grid grid-cols-2 gap-2">
              <a
                href="https://github.com/Hayden0226"
                target="_blank"
                rel="noopener noreferrer"
                class="social-link flex items-center justify-center gap-2 px-3 py-2 rounded-lg transition-colors text-xs col-span-2"
                title="GitHub"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                GitHub
              </a>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="w-full space-y-2">
            <a
              href="https://visuals.haydenweb.com"
              target="_blank"
              rel="noopener noreferrer"
              class="action-button-primary flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg transition-colors font-medium text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Photography
            </a>
          </div>
        </div>
      </AnimatedCard>

      <div class="md:col-span-2 space-y-8">
        <!-- Featured Projects -->
        <AnimatedCard client:load delay={0.1}>
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-2" style="color: var(--text-primary);">
            <svg class="w-6 h-6" style="color: var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/>
            </svg>
            Featured Projects
          </h3>
          <div class="space-y-6">
            <div class="border-l-4 pl-4" style="border-color: var(--accent);">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h4 class="font-bold text-lg" style="color: var(--text-primary);">
                    <a href="https://github.com/Hayden0226/Photography" target="_blank" rel="noopener noreferrer" class="accent-link">Photography</a>
                  </h4>
                  <p style="color: var(--text-secondary);">Personal Photography Gallery</p>
                </div>
                <span class="text-sm whitespace-nowrap" style="color: var(--text-secondary);">TypeScript</span>
              </div>
              <p class="text-sm" style="color: var(--text-secondary);">
                A personal photography gallery deeply customized from Jackyhq/Photography, deployed to GitHub Pages at <a href="https://visuals.haydenweb.com" target="_blank" rel="noopener noreferrer" class="accent-link">visuals.haydenweb.com</a>.
              </p>
            </div>

            <div class="border-l-4 pl-4" style="border-color: var(--border);">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h4 class="font-bold text-lg" style="color: var(--text-primary);">
                    <a href="https://github.com/Hayden0226/LostFound_Office" target="_blank" rel="noopener noreferrer" class="accent-link">LostFound_Office</a>
                  </h4>
                  <p style="color: var(--text-secondary);">Lost &amp; Found Management System</p>
                </div>
                <span class="text-sm whitespace-nowrap" style="color: var(--text-secondary);">Vue</span>
              </div>
              <p class="text-sm" style="color: var(--text-secondary);">
                失物招领管理系统 &mdash; a full-stack web application for managing lost and found items, built with Spring Boot and Vue 3.
              </p>
            </div>
          </div>
        </AnimatedCard>

        <!-- Currently -->
        <AnimatedCard client:load delay={0.2}>
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-2" style="color: var(--text-primary);">
            <svg class="w-6 h-6" style="color: var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Currently
          </h3>
          <div class="space-y-4 text-sm" style="color: var(--text-secondary);">
            <p>Building full-stack web applications with Spring Boot and Vue 3.</p>
            <p>Curating a personal photography gallery at <a href="https://visuals.haydenweb.com" target="_blank" rel="noopener noreferrer" class="accent-link">visuals.haydenweb.com</a>.</p>
            <p>More details about experience and education are coming soon.</p>
          </div>
        </AnimatedCard>
      </div>
    </div>

  </section>
</BaseLayout>
