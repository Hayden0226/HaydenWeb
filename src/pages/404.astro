---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedCard from '../components/AnimatedCard';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 - Page Not Found" description="This page does not exist">
  <div class="max-w-3xl mx-auto text-center py-20">
    <AnimatedCard client:load delay={0}>
      <div class="py-12">
        <h1 class="text-9xl font-bold mb-4" style="color: var(--accent);">404</h1>
        <h2 class="text-3xl font-bold mb-6" style="color: var(--text-primary);">
          Page Not Found
        </h2>
        <p class="text-lg mb-8" style="color: var(--text-secondary);">
          Sorry, the page you're looking for doesn't exist or has been moved.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href={base + "/"}
            class="action-button-primary inline-flex items-center gap-2 px-6 py-3 rounded-lg transition-colors font-medium"
          >
            Go Home
          </a>

          <a
            href={base + "/work"}
            class="action-button-primary inline-flex items-center gap-2 px-6 py-3 rounded-lg transition-colors font-medium"
          >
            Projects
          </a>
        </div>

        <div class="mt-12 pt-8 border-t" style="border-color: var(--border);">
          <p class="text-sm mb-4" style="color: var(--text-secondary);">
            Or jump to a popular page:
          </p>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href={base + "/music"} class="text-sm hover:underline" style="color: var(--accent);">Music</a>
            <span style="color: var(--text-secondary);">•</span>
            <a href={base + "/games"} class="text-sm hover:underline" style="color: var(--accent);">Games</a>
            <span style="color: var(--text-secondary);">•</span>
            <a href={base + "/photography"} class="text-sm hover:underline" style="color: var(--accent);">Photography</a>
            <span style="color: var(--text-secondary);">•</span>
            <a href={base + "/tools"} class="text-sm hover:underline" style="color: var(--accent);">Toodles</a>
          </div>
        </div>
      </div>
    </AnimatedCard>
  </div>
</BaseLayout>
